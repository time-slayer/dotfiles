binds {
    // Applications
    Mod+Return { spawn "alacritty"; }
    Mod+T { spawn "alacritty"; }
    Mod+B { spawn "firefox"; }
    Mod+C { spawn "zeditor"; }
    Mod+E { spawn "thunar"; }

    // Window managment
    Mod+W { toggle-window-floating; }
    Mod+Shift+W { switch-focus-between-floating-and-tiling; }

    // Keyboard layout
    Mod+Space { switch-layout "next"; }
}
